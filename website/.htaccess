# Servereinstellungen fuer den echten Webserver (Apache, All-Inkl).
# Auf der GitHub-Vorschau wird diese Datei ignoriert.

RewriteEngine On

# Die Uebergangsadresse des Hosters (...kasserver.com) NICHT umleiten.
# Sonst laesst sich die Seite vor der Umstellung nicht auf dem echten Server
# testen - jeder Aufruf landet sofort wieder auf der alten Seite.
# Diese Regel muss VOR der Umleitung stehen und bleibt auch nach dem Livegang.
RewriteCond %{HTTP_HOST} \.kasserver\.com$ [NC]
RewriteRule ^ - [L]

# Alles andere: immer https und immer OHNE www
# (so steht es in canonical, sitemap.xml und robots.txt).
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://holistic-smile-design.de/$1 [R=301,L]

# --- Alte Adressen der Vorgaengerseite -------------------------------------
# Keine noetig: Die alte Seite war nur eine "Coming Soon"-Seite ohne
# Unterseiten (geprueft am 01.10.2026).

ErrorDocument 404 /index.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png  "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

Options -Indexes

<IfModule mod_headers.c>
  # HTML nie zwischenspeichern: sonst sehen Besucher (und wir beim
  # Testen) nach einer Aenderung stundenlang die alte Seite.
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
